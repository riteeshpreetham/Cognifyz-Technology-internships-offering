<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bootstrap Responsive Grid</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Styling for the grid cards */
        .card {
            margin: 10px 0;
            border-radius: 10px;
            box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        .card:hover {
            transform: scale(1.05);
        }

        .card-title {
            font-weight: bold;
            color: #333;
        }

        .card-text {
            color: #555;
            font-size: 0.95em;
        }

        .card-img-top {
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-4 col-sm-6">
                <div class="card">
                    <img src="https://hblimg.mmtcdn.com/content/hubble/img/delhi/mmt/activities/m_activities_delhi_red_fort_l_341_817.jpg" class="card-img-top" alt="Red Fort Image">
                    <div class="card-body">
                        <h5 class="card-title">Delhi - Red Fort</h5>
                        <p class="card-text">A historic landmark in India.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="card">
                    <img src="https://c.myholidays.com/blog/blog/content/images/2020/11/Places-To-Visit-In-India.webp" class="card-img-top" alt="India Tourist Spots">
                    <div class="card-body">
                        <h5 class="card-title">Popular Places in India</h5>
                        <p class="card-text">Explore the beauty of India's landscapes.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="card">
                    <img src="https://www.munnar.holiday/munnartourism/wp-content/uploads/2024/09/top-5-tourist-places-in-kerala.jpg" class="card-img-top" alt="Kerala Image">
                    <div class="card-body">
                        <h5 class="card-title">Kerala - God's Own Country</h5>
                        <p class="card-text">Top tourist destinations in Kerala.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
